[Unit]
Description=Yeast.Win fermentation notebook
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=yeast-win
Group=yeast-win
Environment=NODE_ENV=production
EnvironmentFile=/etc/yeast-win/app.env
RuntimeDirectory=yeast-win
RuntimeDirectoryMode=0700
WorkingDirectory=/opt/yeast-win/current
ExecStartPre=/usr/bin/test -f /opt/yeast-win/current/dist/index.html
ExecStart=/usr/bin/node --import tsx server/index.ts
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/yeast-win/data
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true

[Install]
WantedBy=multi-user.target
